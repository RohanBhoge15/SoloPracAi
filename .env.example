# ─────────────────────────────────────────────────────────────────────
# SoloPrac - environment
# Copy to .env and fill in. Never commit the filled version.
# ─────────────────────────────────────────────────────────────────────

ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=false

# ── database ─────────────────────────────────────────────────────────
POSTGRES_USER=solum
POSTGRES_PASSWORD=solum
POSTGRES_DB=solum
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ── stores ──────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=solum_events

# ── local models ────────────────────────────────────────────────────
# Host paths. Inside docker these become /models/... via compose volumes.
MODELS_ROOT=D:/models
MEDCPT_QUERY_PATH=D:/models/MedCPT-Query-Encoder
MEDCPT_ARTICLE_PATH=D:/models/MedCPT-Article-Encoder
BGE_M3_PATH=D:/models/bge-m3
BIOMEDCLIP_PATH=D:/models/BiomedCLIP-PubMedBERT_256-vit_base_patch16_224
MEDGEMMA_GGUF=D:/models/medgemma-gguf

EMBED_DIM=768
ENABLE_VISION=false

# ── LLM ─────────────────────────────────────────────────────────────
# Three free providers, tried in this order. OpenCode leads; Groq is
# second because its open models answer in ~0.1 s; OpenRouter is last
# because its free allowance is a hard 50 requests/day for the whole key.
# All three are free. Set any subset - the chain adapts, and the chat
# endpoint only reports unavailable when none is configured.

# 1. Primary. Get one at https://opencode.ai
OPENCODE_API_KEY=
OPENCODE_MODEL=space-bunny-free
OPENCODE_BASE_URL=https://opencode.ai/zen/v1

# 2. Secondary. Get one at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# 3. Last resort. Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Free tier only - the id must end in :free or it will bill you.
# Verified live: liquid/lfm-2.5-2.6b:free. Re-check at
# https://openrouter.ai/models if this starts returning 404; free models
# get renamed without notice.
LLM_MODEL=liquid/lfm-2.5-2.6b:free
LLM_BASE_URL=https://openrouter.ai/api/v1

# Which of the three leads. Unknown names degrade to the first configured
# provider rather than raising.
LLM_PRIMARY=opencode
# Set false to pin every request to the primary. Also a kill switch.
LLM_FALLBACK_ENABLED=true
LLM_BREAKER_ENABLED=true
LLM_BREAKER_COOLDOWN_S=900

LLM_TEMPERATURE=0.0
LLM_TIMEOUT_S=45
LLM_MAX_RETRIES=3
LLM_CACHE_TTL_S=86400

# Leave true wherever real patient data is present. Do not disable this
# to make an error message go away.
ENFORCE_DEIDENTIFICATION=true

# true replays frozen snapshots with no outbound calls. Used by the
# evaluation harness so results reproduce without network access.
OFFLINE_LLM=false

# ── retrieval ───────────────────────────────────────────────────────
RETRIEVAL_K=8
RETRIEVAL_ALPHA=0.70

# ── capture ─────────────────────────────────────────────────────────
# Below this extraction confidence, nothing is written to the record.
OCR_CONFIDENCE_THRESHOLD=0.75

CORS_ORIGINS=["http://localhost:5173","http://localhost:8080","http://localhost"]
